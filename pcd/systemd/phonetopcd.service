# Started by phonetopcd.socket on the first connection. `phonetopc daemon
# install` points ExecStart at the phonetopcd it finds.
[Unit]
Description=phonetopc daemon: shares the paired phone with programs on this PC
Documentation=https://github.com/melker12345/phonetopc/blob/main/spec/LOCAL-API.md
Requires=phonetopcd.socket
After=phonetopcd.socket

[Service]
ExecStart=/usr/bin/phonetopcd
Restart=on-failure
RestartSec=5

[Install]
Also=phonetopcd.socket

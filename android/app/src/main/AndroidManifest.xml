<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Android 12+ caps sensors at ~200 Hz without this; list_sensors reports the real caps. -->
    <uses-permission
        android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS"
        tools:ignore="HighSamplingRate" />

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Only for scanning a PC's pairing QR code; asked for on the Pair screen. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <!-- Only for the location source, which is off until the user turns it on in Settings;
         asked for there. Platform LocationManager, no Google Play Services. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-feature
        android:name="android.hardware.location"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.location.network"
        android:required="false" />
    <!-- The nfc source: tags scanned while the screen is on. -->
    <uses-permission android:name="android.permission.NFC" />
    <uses-feature
        android:name="android.hardware.nfc"
        android:required="false" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- Android 14 only lets a connectedDevice FGS start if the app holds one of a set of
         prerequisite permissions. These are normal (install-time) permissions, and we do
         change network state: mDNS multicast advertising. -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- The bridge must keep serving with the screen off; the user is asked from onboarding
         and Settings, never automatically. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Only acted on if the user turned on Settings > Start on boot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".PhonetopcApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Phonetopc"
        tools:ignore="DataExtractionRules">
        <!-- allowBackup=false covers Android 8-11, dataExtractionRules covers 12+; no fullBackupContent needed. -->

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Fingerprint approval (APPROVAL.md): a transparent host for the biometric prompt, in
             its own task. Not showWhenLocked: from a locked phone the user unlocks first. -->
        <activity
            android:name=".approval.ApprovalActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="${applicationId}.approval"
            android:theme="@style/Theme.Phonetopc.Approval" />

        <!-- The nfc source while phonetopc is in the background: Android's tag dispatch starts
             it, it passes the tag on and finishes without showing anything. Exported because
             the system NFC service starts it; any app can, so its input is treated as
             untrusted. No catch-all NDEF_DISCOVERED filter: tags with a URL or an app record
             keep opening what they normally open, only tags nothing else claims come here. -->
        <activity
            android:name=".sensors.NfcTagActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:taskAffinity="${applicationId}.nfc"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.nfc.action.TECH_DISCOVERED" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.nfc.action.TAG_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.nfc.action.TECH_DISCOVERED"
                android:resource="@xml/nfc_tech_filter" />
        </activity>

        <receiver
            android:name=".approval.ApprovalActionReceiver"
            android:exported="false" />

        <!-- Panels a PC shows (PANELS.md §4): full screen in their own task, so they can stay
             open next to the app. Not showWhenLocked: a panel never shows over the lock screen. -->
        <activity
            android:name=".panels.PanelActivity"
            android:configChanges="screenSize|screenLayout|smallestScreenSize|keyboardHidden|orientation"
            android:exported="false"
            android:label="@string/panel_label"
            android:launchMode="singleTask"
            android:taskAffinity="${applicationId}.panels"
            android:windowSoftInputMode="adjustResize" />

        <!-- Actions, taps and dismissals of PC notifications (PANELS.md §3.2). -->
        <receiver
            android:name=".output.PcNotificationReceiver"
            android:exported="false" />

        <service
            android:name=".service.BridgeService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice|location" />

        <!-- Both actions are protected broadcasts sent by the system, which may deliver to a
             non-exported receiver. No LOCKED_BOOT_COMPLETED: settings live in
             credential-encrypted storage (see AutoStart). -->
        <receiver
            android:name=".service.AutoStartReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".tile.TapTileService"
            android:exported="true"
            android:icon="@drawable/ic_phonetopc"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
</manifest>

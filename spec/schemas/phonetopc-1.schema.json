{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/melker12345/phonetopc/spec/schemas/phonetopc-1.schema.json",
  "title": "phonetopc/1 messages (draft 4)",
  "description": "Every WebSocket text frame is one of these. See ../PROTOCOL.md.",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/response" },
    { "$ref": "#/$defs/eventNotification" }
  ],
  "$defs": {
    "id": { "type": ["integer", "string"] },

    "request": {
      "type": "object",
      "required": ["jsonrpc", "id", "method"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/id" },
        "method": { "enum": ["hello", "list_sensors", "subscribe", "unsubscribe", "get", "request_approval",
                             "decrypt", "notify", "notify_cancel", "panel_show", "panel_attach", "panel_update", "panel_close",
                             "panel_list", "canvas_clear"] },
        "params": { "type": ["object", "null"] }
      },
      "allOf": [
        { "if": { "properties": { "method": { "const": "hello" } } },
          "then": { "required": ["params"], "properties": { "params": { "$ref": "#/$defs/helloParams" } } } },
        { "if": { "properties": { "method": { "const": "subscribe" } } },
          "then": { "required": ["params"], "properties": { "params": { "$ref": "#/$defs/subscribeParams" } } } },
        { "if": { "properties": { "method": { "const": "unsubscribe" } } },
          "then": { "required": ["params"], "properties": { "params": { "$ref": "#/$defs/unsubscribeParams" } } } },
        { "if": { "properties": { "method": { "const": "request_approval" } } },
          "then": { "required": ["params"], "properties": { "params": { "$ref": "#/$defs/requestApprovalParams" } } } },
        { "if": { "properties": { "method": { "const": "decrypt" } } },
          "then": { "required": ["params"], "properties": { "params": { "$ref": "#/$defs/decryptParams" } } } },
        { "if": { "properties": { "method": { "const": "get" } } },
          "then": { "required": ["params"], "properties": { "params": { "$ref": "#/$defs/getParams" } } } },
        { "if": { "properties": { "method": { "const": "notify" } } },
          "then": { "required": ["params"], "properties": { "params": { "$ref": "#/$defs/notifyParams" } } } },
        { "if": { "properties": { "method": { "const": "notify_cancel" } } },
          "then": { "required": ["params"], "properties": { "params": { "$ref": "#/$defs/notifyCancelParams" } } } },
        { "if": { "properties": { "method": { "const": "panel_show" } } },
          "then": { "required": ["params"], "properties": { "params": { "$ref": "#/$defs/panelShowParams" } } } },
        { "if": { "properties": { "method": { "const": "panel_attach" } } },
          "then": { "required": ["params"], "properties": { "params": { "$ref": "#/$defs/panelAttachParams" } } } },
        { "if": { "properties": { "method": { "const": "panel_update" } } },
          "then": { "required": ["params"], "properties": { "params": { "$ref": "#/$defs/panelUpdateParams" } } } },
        { "if": { "properties": { "method": { "const": "panel_close" } } },
          "then": { "required": ["params"], "properties": { "params": { "$ref": "#/$defs/panelRef" } } } },
        { "if": { "properties": { "method": { "const": "canvas_clear" } } },
          "then": { "required": ["params"], "properties": { "params": { "$ref": "#/$defs/canvasClearParams" } } } }
      ]
    },

    "response": {
      "type": "object",
      "required": ["jsonrpc", "id"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "result": {},
        "error": { "$ref": "#/$defs/error" }
      },
      "oneOf": [{ "required": ["result"] }, { "required": ["error"] }]
    },

    "error": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "integer" },
        "message": { "type": "string" },
        "data": { "type": "object", "properties": { "name": { "type": "string" } } }
      }
    },

    "helloParams": {
      "type": "object",
      "required": ["protocol"],
      "properties": {
        "protocol": { "type": "string" },
        "client": {
          "type": "object",
          "properties": { "name": { "type": "string" }, "version": { "type": "string" } }
        },
        "auth": {
          "type": "object", "required": ["token"],
          "properties": { "token": { "type": "string", "description": "32 bytes, base64url without padding (SECURITY.md §2)", "pattern": "^[A-Za-z0-9_-]{43}$" } }
        }
      }
    },

    "helloResult": {
      "type": "object",
      "required": ["protocol", "server", "device", "capabilities"],
      "properties": {
        "protocol": { "const": "phonetopc/1" },
        "server": {
          "type": "object", "required": ["name", "version"],
          "properties": { "name": { "type": "string" }, "version": { "type": "string" } }
        },
        "device": {
          "type": "object", "required": ["id", "name", "platform"],
          "properties": {
            "id": { "type": "string", "pattern": "^[0-9a-f]{16,64}$" },
            "name": { "type": "string" },
            "manufacturer": { "type": "string" },
            "model": { "type": "string" },
            "platform": { "type": "string" },
            "platform_version": { "type": "string" }
          }
        },
        "capabilities": { "type": "array", "items": { "type": "string" } },
        "pc": {
          "type": "object", "required": ["id", "name"],
          "properties": { "id": { "type": "string" }, "name": { "type": "string" } }
        },
        "approval": {
          "type": "object", "required": ["key", "pin"],
          "properties": { "key": { "type": "string" }, "pin": { "type": "string" } }
        },
        "decrypt": {
          "type": "object", "required": ["key", "pin"],
          "properties": { "key": { "type": "string" }, "pin": { "type": "string" } }
        }
      }
    },

    "sensorInfo": {
      "type": "object",
      "required": ["source", "types", "unit", "shape", "mode", "available"],
      "properties": {
        "source": { "type": "string" },
        "types": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "unit": { "type": "string" },
        "shape": { "enum": ["number", "bool", "vec3", "quat", "object"] },
        "mode": { "enum": ["continuous", "on_change"] },
        "min_rate_hz": { "type": "number", "exclusiveMinimum": 0 },
        "max_rate_hz": { "type": "number", "exclusiveMinimum": 0 },
        "default_rate_hz": { "type": "number", "exclusiveMinimum": 0 },
        "available": { "type": "boolean" }
      }
    },

    "listSensorsResult": {
      "type": "object", "required": ["sensors"],
      "properties": { "sensors": { "type": "array", "items": { "$ref": "#/$defs/sensorInfo" } } }
    },

    "subscribeParams": {
      "type": "object",
      "required": ["source"],
      "properties": {
        "source": { "type": "string" },
        "type": { "type": "string" },
        "rate_hz": { "type": "number", "exclusiveMinimum": 0 },
        "min_delta": { "type": "number", "minimum": 0 }
      }
    },

    "subscribeResult": {
      "type": "object",
      "required": ["subscription", "source", "types", "mode"],
      "properties": {
        "subscription": { "type": "string" },
        "source": { "type": "string" },
        "types": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "mode": { "enum": ["continuous", "on_change"] },
        "rate_hz": { "type": "number", "exclusiveMinimum": 0 }
      },
      "allOf": [
        { "if": { "required": ["mode"], "properties": { "mode": { "const": "continuous" } } },
          "then": { "required": ["rate_hz"] } },
        { "if": { "required": ["mode"], "properties": { "mode": { "const": "on_change" } } },
          "then": { "not": { "required": ["rate_hz"] } } }
      ]
    },

    "requestApprovalParams": {
      "type": "object", "required": ["reason", "nonce"],
      "properties": {
        "reason": { "type": "string", "minLength": 1, "maxLength": 200 },
        "nonce": { "type": "string", "minLength": 43, "maxLength": 43 },
        "timeout_ms": { "type": "integer", "minimum": 5000, "maximum": 120000 }
      }
    },

    "requestApprovalResult": {
      "type": "object", "required": ["approved"],
      "properties": {
        "approved": { "type": "boolean" },
        "signature": { "type": "string" },
        "why": { "enum": ["denied", "cancelled", "timeout", "busy", "lockout", "unavailable"] }
      },
      "if": { "properties": { "approved": { "const": true } } },
      "then": { "required": ["signature"] },
      "else": { "required": ["why"] }
    },

    "decryptParams": {
      "type": "object", "required": ["reason", "key_pin", "ciphertext"],
      "properties": {
        "reason": { "type": "string", "minLength": 1, "maxLength": 200 },
        "key_pin": { "type": "string" },
        "ciphertext": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
        "timeout_ms": { "type": "integer", "minimum": 5000, "maximum": 120000 }
      }
    },

    "decryptResult": {
      "type": "object", "required": ["decrypted"],
      "properties": {
        "decrypted": { "type": "boolean" },
        "plaintext": { "type": "string" },
        "why": { "enum": ["denied", "cancelled", "timeout", "busy", "lockout", "unavailable", "failed"] }
      },
      "if": { "properties": { "decrypted": { "const": true } } },
      "then": { "required": ["plaintext"] },
      "else": { "required": ["why"] }
    },

    "unsubscribeResult": { "type": "object", "maxProperties": 0 },

    "resultByMethod": {
      "description": "Result schema per request method. Responses don't name their method, so validate a result by correlating the response id with its request.",
      "type": "object",
      "properties": {
        "hello": { "$ref": "#/$defs/helloResult" },
        "list_sensors": { "$ref": "#/$defs/listSensorsResult" },
        "subscribe": { "$ref": "#/$defs/subscribeResult" },
        "unsubscribe": { "$ref": "#/$defs/unsubscribeResult" },
        "get": { "$ref": "#/$defs/reading" },
        "request_approval": { "$ref": "#/$defs/requestApprovalResult" },
        "decrypt": { "$ref": "#/$defs/decryptResult" },
        "notify": { "$ref": "#/$defs/notifyResult" },
        "notify_cancel": { "$ref": "#/$defs/emptyResult" },
        "panel_show": { "$ref": "#/$defs/panelShowResult" },
        "panel_attach": { "$ref": "#/$defs/panelAttachResult" },
        "panel_update": { "$ref": "#/$defs/emptyResult" },
        "panel_close": { "$ref": "#/$defs/emptyResult" },
        "panel_list": { "$ref": "#/$defs/panelListResult" },
        "canvas_clear": { "$ref": "#/$defs/emptyResult" }
      }
    },

    "unsubscribeParams": {
      "type": "object", "required": ["subscription"],
      "properties": { "subscription": { "type": "string" } }
    },

    "getParams": {
      "type": "object", "required": ["source"],
      "properties": { "source": { "type": "string" }, "type": { "type": "string" } }
    },

    "reading": {
      "type": "object",
      "required": ["source", "type", "value", "unit", "ts", "ts_mono_ns", "device"],
      "properties": {
        "source": { "type": "string" },
        "type": { "type": "string" },
        "value": {},
        "unit": { "type": "string" },
        "ts": { "type": "integer" },
        "ts_mono_ns": { "type": "integer" },
        "device": { "type": "string" }
      },
      "allOf": [
        { "if": { "properties": { "source": { "enum": ["accelerometer", "gyro", "magnetometer"] } } },
          "then": { "properties": { "value": { "$ref": "#/$defs/vec3" } } } },
        { "if": { "properties": { "source": { "enum": ["game_rotation_vector", "rotation_vector"] } } },
          "then": { "properties": { "value": { "$ref": "#/$defs/quat" } } } },
        { "if": { "properties": { "source": { "enum": ["proximity", "light", "barometer"] } } },
          "then": { "properties": { "value": { "type": "number" } } } },
        { "if": { "properties": { "source": { "const": "compass" } } },
          "then": { "properties": { "value": { "type": "number", "minimum": 0, "exclusiveMaximum": 360 } } } },
        { "if": { "properties": { "source": { "const": "battery" } } },
          "then": { "properties": { "value": {
            "type": "object", "required": ["level", "charging"],
            "properties": { "level": { "type": "number", "minimum": 0, "maximum": 100 }, "charging": { "type": "boolean" } } } } } },
        { "if": { "properties": { "source": { "const": "location" } } },
          "then": { "properties": { "value": { "$ref": "#/$defs/position" } } } },
        { "if": { "properties": { "source": { "const": "ui" } } },
          "then": { "properties": { "value": { "type": "boolean" } } } },
        { "if": { "properties": { "source": { "const": "notification" } } },
          "then": { "properties": { "value": { "$ref": "#/$defs/notificationEvent" } } } },
        { "if": { "properties": { "source": { "const": "panel" } } },
          "then": { "properties": { "value": { "$ref": "#/$defs/panelEvent" } } } },
        { "if": { "properties": { "source": { "const": "nfc" } } },
          "then": { "properties": { "value": { "$ref": "#/$defs/tag" } } } }
      ]
    },

    "eventNotification": {
      "type": "object",
      "required": ["jsonrpc", "method", "params"],
      "not": { "required": ["id"] },
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "method": { "const": "event" },
        "params": {
          "allOf": [
            { "$ref": "#/$defs/reading" },
            {
              "type": "object",
              "required": ["subscription", "seq"],
              "properties": {
                "subscription": { "type": "string" },
                "seq": { "type": "integer", "minimum": 0 }
              }
            }
          ]
        }
      }
    },

    "position": {
      "description": "location/position (PROTOCOL.md §6)",
      "type": "object", "required": ["lat", "lon", "accuracy_m"],
      "properties": {
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lon": { "type": "number", "minimum": -180, "maximum": 180 },
        "accuracy_m": { "type": "number", "minimum": 0 },
        "altitude_m": { "type": "number" },
        "speed_mps": { "type": "number", "minimum": 0 },
        "bearing_deg": { "type": "number", "minimum": 0, "exclusiveMaximum": 360 }
      }
    },
    "tag": {
      "description": "nfc/tag (PROTOCOL.md §6)",
      "type": "object", "required": ["id", "tech"],
      "properties": {
        "id": { "type": "string", "pattern": "^([0-9a-f]{2})*$" },
        "tech": { "type": "array", "items": { "type": "string" } },
        "ndef": {
          "type": "array",
          "items": {
            "type": "object", "required": ["tnf", "type", "payload"],
            "properties": {
              "tnf": { "type": "integer", "minimum": 0, "maximum": 7 },
              "type": { "type": "string" },
              "payload": { "type": "string", "pattern": "^([0-9a-f]{2})*$" },
              "text": { "type": "string" },
              "uri": { "type": "string" }
            }
          }
        }
      }
    },

    "panelId": { "description": "PANELS.md §8", "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,64}$" },
    "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
    "line": {
      "description": "Display text without newlines (PANELS.md §8). The pattern holds the characters themselves as JSON escapes, not regex escapes; U+E0000–U+E007F appear as surrogate pairs, which a regex engine must read as code points. JSON Schema lengths count code points, like the spec.",
      "type": "string", "pattern": "^[^\u0000-\u001f\u007f-\u009f\u00ad\u061c\u180e\u200b\u200e\u200f\u2028\u2029\u202a-\u202e\u2060-\u2064\u2066-\u206f\ufeff\ufff9-\ufffb\udb40\udc00-\udb40\udc7f]*$"
    },
    "text": {
      "description": "Display text, newlines allowed (PANELS.md §8).",
      "type": "string", "pattern": "^[^\u0000-\u0009\u000b-\u001f\u007f-\u009f\u00ad\u061c\u180e\u200b\u200e\u200f\u2028\u2029\u202a-\u202e\u2060-\u2064\u2066-\u206f\ufeff\ufff9-\ufffb\udb40\udc00-\udb40\udc7f]*$"
    },
    "emptyResult": { "type": "object", "maxProperties": 0 },

    "notifyParams": {
      "type": "object", "required": ["title"],
      "properties": {
        "title": { "allOf": [{ "$ref": "#/$defs/line" }, { "minLength": 1, "maxLength": 100 }] },
        "body": { "allOf": [{ "$ref": "#/$defs/text" }, { "maxLength": 1000 }] },
        "id": { "$ref": "#/$defs/panelId" },
        "actions": {
          "type": "array", "maxItems": 3,
          "items": {
            "type": "object", "required": ["id", "label"],
            "properties": { "id": { "$ref": "#/$defs/panelId" }, "label": { "allOf": [{ "$ref": "#/$defs/line" }, { "minLength": 1, "maxLength": 30 }] } }
          }
        },
        "priority": { "enum": ["default", "high"] }
      }
    },
    "notifyResult": { "type": "object", "required": ["id"], "properties": { "id": { "$ref": "#/$defs/panelId" } } },
    "notifyCancelParams": { "type": "object", "required": ["id"], "properties": { "id": { "$ref": "#/$defs/panelId" } } },

    "panelRef": { "type": "object", "required": ["panel"], "properties": { "panel": { "$ref": "#/$defs/panelId" } } },
    "panelShowParams": {
      "type": "object", "required": ["panel", "title", "layout"],
      "properties": {
        "panel": { "$ref": "#/$defs/panelId" },
        "title": { "allOf": [{ "$ref": "#/$defs/line" }, { "minLength": 1, "maxLength": 60 }] },
        "layout": { "$ref": "#/$defs/widget" },
        "keep_awake": { "type": "boolean" },
        "orientation": { "enum": ["any", "portrait", "landscape"] }
      }
    },
    "panelShowResult": {
      "type": "object", "required": ["panel", "visible"],
      "properties": { "panel": { "$ref": "#/$defs/panelId" }, "visible": { "type": "boolean" } }
    },
    "panelAttachParams": {
      "type": "object", "required": ["panel"],
      "properties": { "panel": { "$ref": "#/$defs/panelId" }, "after_pseq": { "type": "integer", "minimum": -1 } }
    },
    "panelAttachResult": {
      "type": "object", "required": ["panel", "title", "visible", "last_pseq", "values"],
      "properties": {
        "panel": { "$ref": "#/$defs/panelId" },
        "title": { "type": "string" },
        "visible": { "type": "boolean" },
        "last_pseq": { "type": "integer", "minimum": -1 },
        "values": { "type": "object", "additionalProperties": { "type": ["boolean", "number"] } }
      }
    },
    "panelUpdateParams": {
      "type": "object", "required": ["panel", "updates"],
      "properties": {
        "panel": { "$ref": "#/$defs/panelId" },
        "updates": {
          "type": "array", "minItems": 1, "maxItems": 64,
          "items": {
            "type": "object", "required": ["widget", "set"],
            "properties": {
              "widget": { "$ref": "#/$defs/panelId" },
              "set": { "type": "object", "not": { "anyOf": [{ "required": ["type"] }, { "required": ["id"] }, { "required": ["children"] }] } }
            }
          }
        }
      }
    },
    "panelListResult": {
      "type": "object", "required": ["panels"],
      "properties": {
        "panels": {
          "type": "array", "maxItems": 8,
          "items": {
            "type": "object", "required": ["panel", "title", "attached", "visible"],
            "properties": {
              "panel": { "$ref": "#/$defs/panelId" }, "title": { "type": "string" },
              "attached": { "type": "boolean" }, "visible": { "type": "boolean" }
            }
          }
        }
      }
    },
    "canvasClearParams": {
      "type": "object", "required": ["panel", "widget"],
      "properties": { "panel": { "$ref": "#/$defs/panelId" }, "widget": { "$ref": "#/$defs/panelId" } }
    },

    "widget": {
      "description": "PANELS.md §5. Limits on the whole tree (256 widgets, 8 levels, unique ids) are checked by the servers.",
      "type": "object", "required": ["type"],
      "properties": {
        "type": { "enum": ["column", "row", "grid", "text", "button", "toggle", "slider", "progress", "text_input", "canvas"] },
        "id": { "$ref": "#/$defs/panelId" },
        "weight": { "type": "number", "exclusiveMinimum": 0 },
        "enabled": { "type": "boolean" },
        "tone": { "enum": ["default", "accent", "good", "warn", "bad"] }
      },
      "allOf": [
        { "if": { "properties": { "type": { "enum": ["column", "row"] } } },
          "then": { "required": ["children"],
            "properties": { "children": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/$defs/widget" } } } } },
        { "if": { "properties": { "type": { "const": "grid" } } },
          "then": { "required": ["cols", "children"],
            "properties": { "cols": { "type": "integer", "minimum": 1, "maximum": 8 },
              "children": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/$defs/widget" } } } } },
        { "if": { "properties": { "type": { "const": "text" } } },
          "then": { "required": ["text"],
            "properties": { "text": { "allOf": [{ "$ref": "#/$defs/text" }, { "maxLength": 4000 }] },
              "size": { "enum": ["small", "body", "title", "display"] }, "align": { "enum": ["start", "center", "end"] } } } },
        { "if": { "properties": { "type": { "const": "button" } } },
          "then": { "required": ["id", "label"],
            "properties": { "label": { "allOf": [{ "$ref": "#/$defs/line" }, { "minLength": 1, "maxLength": 100 }] } } } },
        { "if": { "properties": { "type": { "const": "toggle" } } },
          "then": { "required": ["id", "label"],
            "properties": { "label": { "allOf": [{ "$ref": "#/$defs/line" }, { "minLength": 1, "maxLength": 100 }] }, "value": { "type": "boolean" } } } },
        { "if": { "properties": { "type": { "const": "slider" } } },
          "then": { "required": ["id"],
            "properties": { "label": { "allOf": [{ "$ref": "#/$defs/line" }, { "maxLength": 100 }] }, "min": { "type": "number" }, "max": { "type": "number" },
              "step": { "type": "number", "exclusiveMinimum": 0 }, "value": { "type": "number" } } } },
        { "if": { "properties": { "type": { "const": "progress" } } },
          "then": { "properties": { "label": { "allOf": [{ "$ref": "#/$defs/line" }, { "maxLength": 100 }] },
              "value": { "anyOf": [{ "type": "number", "minimum": 0, "maximum": 1 }, { "type": "null" }] } } } },
        { "if": { "properties": { "type": { "const": "text_input" } } },
          "then": { "required": ["id"],
            "properties": { "label": { "allOf": [{ "$ref": "#/$defs/line" }, { "maxLength": 100 }] }, "placeholder": { "allOf": [{ "$ref": "#/$defs/line" }, { "maxLength": 100 }] },
              "value": { "allOf": [{ "$ref": "#/$defs/text" }, { "maxLength": 4000 }] }, "multiline": { "type": "boolean" },
              "max_length": { "type": "integer", "minimum": 1, "maximum": 4000 }, "clear_on_submit": { "type": "boolean" } } } },
        { "if": { "properties": { "type": { "const": "canvas" } } },
          "then": { "required": ["id"],
            "properties": { "ink": { "type": "boolean" }, "color": { "$ref": "#/$defs/color" },
              "width": { "type": "number", "minimum": 0.5, "maximum": 64 }, "background": { "$ref": "#/$defs/color" } } } }
      ]
    },

    "notificationEvent": {
      "description": "notification/* (PANELS.md §3.2)",
      "type": "object", "required": ["notification"],
      "properties": { "notification": { "$ref": "#/$defs/panelId" }, "action": { "$ref": "#/$defs/panelId" } }
    },
    "panelEvent": {
      "description": "panel/* (PANELS.md §6, §7)",
      "type": "object", "required": ["panel", "pseq"],
      "properties": {
        "panel": { "$ref": "#/$defs/panelId" },
        "pseq": { "type": "integer", "minimum": 0 },
        "widget": { "$ref": "#/$defs/panelId" },
        "state": { "enum": ["visible", "hidden", "closed"] },
        "reason": { "enum": ["user", "revoked"] },
        "value": { "type": ["boolean", "number", "string"] },
        "final": { "type": "boolean" },
        "replayed": { "type": "boolean" },
        "stroke": { "type": "integer", "minimum": 0 },
        "phase": { "enum": ["start", "move", "end", "cancel"] },
        "tool": { "enum": ["finger", "stylus", "eraser", "mouse", "unknown"] },
        "size": { "type": "array", "items": { "type": "number", "minimum": 0 }, "minItems": 2, "maxItems": 2 },
        "points": {
          "type": "array", "maxItems": 128,
          "items": {
            "type": "array", "minItems": 4, "maxItems": 4,
            "prefixItems": [
              { "type": "number", "minimum": 0, "maximum": 1 },
              { "type": "number", "minimum": 0, "maximum": 1 },
              { "type": "number", "minimum": 0, "maximum": 1 },
              { "type": "integer", "minimum": 0 }
            ]
          }
        }
      }
    },

    "vec3": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
    "quat": { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4 }
  }
}
